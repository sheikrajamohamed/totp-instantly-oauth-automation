# Copy to .env and fill in. Never commit the real .env.

# --- OAuth provider ---
INSTANTLY_API_KEY=
INSTANTLY_DFY_KEY=

# --- TOTP service ---
TOTP_API_KEY=

# --- Result reporting (optional; skipped if blank) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- HTTP endpoint auth ---
API_KEY=

# --- Runtime / concurrency (optional overrides) ---
MAX_PARALLEL=100
MAX_CONCURRENT_LAUNCHES=6
MIN_FREE_MB=1500
MAX_RETRIES=10
HEADLESS=false
PAGELOAD_TIMEOUT=90
PORT=5000
HOST=0.0.0.0
