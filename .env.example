# Copy to .env and fill in. Never commit the real .env.

# --- OAuth provider ---
OAUTH_API_KEY=
OAUTH_INIT_URL=
OAUTH_INTERNAL_KEY=
# Host the provider redirects to on a successful grant, e.g. example.com
OAUTH_REDIRECT_HOST=

# --- TOTP service ---
TOTP_API_URL=
TOTP_API_KEY=

# --- Result reporting (optional; skipped if blank) ---
REPORT_DB_URL=
REPORT_DB_KEY=

# --- HTTP endpoint auth ---
API_KEY=

# --- Runtime / concurrency (optional overrides) ---
MAX_PARALLEL=100
MAX_CONCURRENT_LAUNCHES=6
MIN_FREE_MB=1500
MAX_RETRIES=10
HEADLESS=false
PAGELOAD_TIMEOUT=90
PORT=5000
HOST=0.0.0.0
